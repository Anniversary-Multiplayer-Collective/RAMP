# ----------------------------------------------------------------
# I                          CHAIN GUN                           I
# ----------------------------------------------------------------
EditTag ui\chud\plasma_rifle.chud_definition
CopyBlockElements HudWidgets 5 1
Exit

EditTag ui\chud\v_chaingun.chud_definition
PasteBlockElements HudWidgets
RemoveBlockElements HudWidgets[1].TextWidgets 0 *
SetField HudWidgets[0].BitmapWidgets[0].PlacementData[0].Scale 0.7 0.7
SetField HudWidgets[1].BitmapWidgets[1].BitmapSequenceIndex 23

SetField HudWidgets[1].BitmapWidgets[0].RuntimeWidgetIndex 1
SetField HudWidgets[1].BitmapWidgets[1].RuntimeWidgetIndex 2
SetField HudWidgets[1].BitmapWidgets[2].RuntimeWidgetIndex 3
SetField HudWidgets[1].BitmapWidgets[3].RuntimeWidgetIndex 4
SetField HudWidgets[1].BitmapWidgets[4].RuntimeWidgetIndex 5
SetField HudWidgets[1].BitmapWidgets[5].RuntimeWidgetIndex 6

SaveTagChanges
Exit

